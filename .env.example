# Public frontend configuration (never put secrets here)

# External API base URL (backend lives outside this repository)
VITE_API_BASE_URL=https://api.example.com

# Auth mode: `demo` = built-in demo users (prototype, no backend needed)
#            `api`  = real backend session (httpOnly cookie, GET /auth/me)
VITE_AUTH_MODE=demo

# Optional app environment label
VITE_APP_ENV=development
